# IP estavel ou DNS desta maquina, alcancavel por todos os clientes CORBA.
# JacORB inclui este endereco nas referencias dos servicos; clientes devem alcanca-lo
# nas portas TCP 1050 (Naming Service) e 2809 (servicos). Nao use localhost/nome Docker.
CORBA_PUBLIC_HOST=192.168.1.50
HOSPITAL_TIMEZONE=Africa/Maputo
MEDISYNC_ADMIN_USERNAME=admin
# A palavra-passe inicial deve ter pelo menos 10 caracteres; substitua o exemplo.
MEDISYNC_ADMIN_PASSWORD=change-this-to-a-strong-password
